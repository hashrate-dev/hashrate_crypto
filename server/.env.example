# Configuración LOCAL (localhost). Datos en server/data/users.json y access_log.json
# Puerto del servidor (opcional, por defecto 3001)
# PORT=3001

# --- Email: aviso al cambiar contraseña ---
# Si no configurás estas variables, el cambio de contraseña funciona igual pero no se envía email.

# Gmail: usar una "Contraseña de aplicación" (no tu contraseña normal).
# Creala en: Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Remitente que verá el usuario (opcional)
# EMAIL_FROM=Wallet <noreply@tudominio.com>

# Otros proveedores:
# Outlook/Hotmail: smtp.office365.com, puerto 587
# Yahoo: smtp.mail.yahoo.com, puerto 587
# Mailtrap (pruebas): smtp.mailtrap.io, usuario y contraseña de tu inbox

# --- Solana: historial de transacciones (como Orb Transfers) ---
# Opcional: historial SOL igual que en solscan.io (API Pro). Obtener clave en https://solscan.io/apis
# SOLSCAN_API_KEY=tu_token_solscan_pro
#
# Con HELIUS_API_KEY la app usa la Wallet API de Helius (/v1/wallet/.../transfers), la misma familia que Orb.
# Sin clave, los RPC públicos suelen devolver vacío. Creá una cuenta en https://helius.dev y agregá la key en .env.
# HELIUS_API_KEY=tu-api-key-helius

# --- Ethereum: historial de transacciones (Etherscan) ---
# Opcional. Sin clave Etherscan puede limitar peticiones. Creá una en https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=tu-api-key-etherscan

# --- Lightning (facturas BOLT11 con QR) vía LNbits ---
# Sin esto las facturas son de prueba (no cobrables). Para facturas reales:
# 1. Entrá a https://lnbits.com (o tu instancia), creá una wallet.
# 2. En la wallet: "API Info" → copiá "Invoice/Read Key".
# LNBITS_URL=https://lnbits.com
# LNBITS_INVOICE_KEY=tu-invoice-read-key

# --- Jupiter Swap (Solana): comisión por transacción ---
# Wallet que recibe la comisión (tu wallet en Jupiter). Por defecto: 9PMkkTEdEPyrACphv1sEqjJvtC51y6qr224EBcRN6fxc
# JUPITER_FEE_WALLET=9PMkkTEdEPyrACphv1sEqjJvtC51y6qr224EBcRN6fxc
# Comisión en basis points (ej. 20 = 0,2%). Por defecto 20.
# JUPITER_PLATFORM_FEE_BPS=20

